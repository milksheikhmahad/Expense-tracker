# Optional overrides for local runs (copy to backend/.env).
# Leave blank to keep the local fallbacks.

# Send real alert emails while developing locally:
# ACS_CONNECTION_STRING=endpoint=https://<name>.communication.azure.com/;accesskey=...
# EMAIL_SENDER=DoNotReply@<guid>.azurecomm.net

# Receipt OCR with Azure AI Document Intelligence:
# DOCINTEL_ENDPOINT=https://<name>.cognitiveservices.azure.com
# DOCINTEL_KEY=...

# AI insights with Azure OpenAI:
# AZURE_OPENAI_ENDPOINT=https://<name>.openai.azure.com
# AZURE_OPENAI_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
